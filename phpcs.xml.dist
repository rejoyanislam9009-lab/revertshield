<?xml version="1.0"?>
<ruleset name="RevertShield">
	<description>WordPress coding standards for RevertShield.</description>
	<file>revertshield.php</file>
	<file>src</file>
	<file>uninstall.php</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>
</ruleset>
